# 이 파일을 .env로 복사해 값을 채우세요. .env는 커밋되지 않습니다(.gitignore).
# 모든 값은 서버에서만 사용하며 클라이언트 번들에 포함되지 않습니다.

# --- Airtable ---
# 쓰기용 개인 액세스 토큰 (필수) — 스코프 data.records:write, 대상 base: 고객관리
# https://airtable.com/create/tokens
AIRTABLE_TOKEN=
# 읽기 전용 토큰 (선택) — 있으면 FAQ 조회에 이 토큰을 우선 사용한다(최소 권한)
AIRTABLE_READ_TOKEN=

AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE_ID=
AIRTABLE_FAQ_TABLE_ID=
AIRTABLE_CHATLOGS_TABLE_ID=

# --- 챗봇 LLM (OpenAI) ---
LLM_API_KEY=
CHAT_MODEL=gpt-5.6-luna
CHAT_BOT_NAME=큐브
